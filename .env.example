# Environment Configurations for Cotador Inteligente ST
# Copy this file to .env before running the application

# Application Mode
APP_ENV=development

# Logger configuration (info, warn, error, debug)
LOG_LEVEL=info

# Scraper security toggles
# ENABLE_REAL_CONNECTORS=true requires manual login and real scraping
ENABLE_MOCK_CONNECTORS=true
ENABLE_REAL_CONNECTORS=false
