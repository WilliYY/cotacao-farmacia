# Environment Configurations for Cotador Inteligente ST
# Copy this file to .env before running the application

# Application Mode
APP_ENV=development
AUTO_UPDATE_ON_STARTUP=true
# Check for new commits every 15 minutes while the app remains open.
AUTO_UPDATE_CHECK_INTERVAL_MS=900000
# Allow slower connections without waiting forever (5 seconds to 2 minutes).
AUTO_UPDATE_FETCH_TIMEOUT_MS=30000
# Optional: set only when the deployed checkout should follow a named branch.
AUTO_UPDATE_BRANCH=

# Logger configuration (info, warn, error, debug)
LOG_LEVEL=info

# Scraper security toggles
# Real portals are the operational default. Mocks require explicit test-only opt-in.
ENABLE_MOCK_CONNECTORS=false
ENABLE_REAL_CONNECTORS=true
SHOW_SCRAPER_WINDOW=false
ANB_COMMERCIAL_CONDITION=PREMIUM TOP 7 DIAS
VITE_ENABLE_UI_MOCKS=false
# DM Playwright is opt-in until a live smoke succeeds on every target PC. "auto" falls back only before interaction.
DM_BROWSER_ENGINE=electron
DM_PLAYWRIGHT_CHANNEL=msedge
DM_PLAYWRIGHT_PAGE_TIMEOUT_MS=30000
DM_PLAYWRIGHT_SEARCH_TIMEOUT_MS=12000
DM_PLAYWRIGHT_MAX_PAGES=50
# Tracing begins only after login, so the password is not captured.
DM_PLAYWRIGHT_TRACE=on-failure
SCRAPER_TIMEOUT_MS=300000
CONNECTOR_TIMEOUT_MS=300000
SANTACRUZ_TIMEOUT_MS=600000
QUOTE_TIMEOUT_MS=600000
CONNECTOR_RETRY_COUNT=1
CONNECTOR_RETRY_DELAY_MS=1000
# After this many consecutive transient item failures, use one half-open probe per next item.
SUPPLIER_FAILURE_THRESHOLD=3
# Short bounded pause before a half-open recovery probe (0 to 30000 ms).
SUPPLIER_RECOVERY_COOLDOWN_MS=3000
SANTACRUZ_UPDATE_WAIT_SECONDS=300
SANTACRUZ_STARTUP_WAIT_SECONDS=180
SANTACRUZ_HEADLESS_GRACE_SECONDS=240
SANTACRUZ_RESULT_WAIT_SECONDS=45
SANTACRUZ_RESTORE_FOCUS=true
DISABLE_HARDWARE_ACCELERATION=true

# Portability configuration (use 'local' to save DB in the project directory, or leave empty for user profile AppData)
DATABASE_PATH=local
# 'plain' keeps credentials portable with the local database. Use 'dpapi' for machine-bound Windows protection.
CREDENTIAL_STORAGE_MODE=plain

# Database Configuration (sqlite or postgres)
DB_TYPE=sqlite
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=yourpassword
PG_DATABASE=cotador_st
