{
  "appId": "com.wimifarma.cotacao",
  "productName": "Wimifarma Cotação",
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "dist/**/*",
    "main.js",
    "preload.js",
    "src/**/*",
    "package.json",
    "node_modules/**/*"
  ],
  "win": {
    "target": "nsis"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
